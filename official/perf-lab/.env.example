# Copy to .env and adjust for your local or deployed demo environment.
# REST and gRPC talk to Kestrel over TLS. Graftcode from the browser goes
# through Vite's h2c proxy (https://localhost:5173/graft/h2 → gg :5001/h2).

# REST backend  -> HTTP/2 over TLS (Kestrel). Browser-ready.
VITE_REST_URL=https://localhost:8090

# gRPC-Web backend -> HTTP/2 over TLS (Kestrel/.NET, grpc-energy-price-dotnet).
# Same runtime as REST so gRPC-vs-REST is an apples-to-apples comparison.
VITE_GRPC_URL=https://localhost:5005

# Browser talks to Vite over TLS (mkcert). Graftcode default is same-origin
# WSS (/graft-ws → gg :5000/ws) because gg 1.4.6 RST_STREAMs Node http2 POST /h2.
# Set VITE_GRAFT_TRANSPORT=h2 to send GraftConfig to /graft/h2 (Vite h2c plugin → :5001).
VITE_GRAFT_H2_PATH=/graft/h2
# VITE_GRAFT_TRANSPORT=h2

# Native / non-browser clients can hit h2c directly:
#   http://localhost:5001/h2
VITE_GRAFT_HTTP2_URL=http://localhost:5001

# Direct WebSocket (not from the HTTPS Vite page — mixed content):
VITE_GRAFT_WS_URL=ws://localhost:5000/ws
