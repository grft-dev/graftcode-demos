# Environment template for perf-lab (only this file is committed).
#
#   Local: copy variable names/values into `.env.local` (gitignored), then `npm run dev`
#   Azure: same into `.env.dev` (gitignored), then `npm run dev:azure` (URLs from your deploy / team)
#
# Backends in this repo: official/electric-company-ws, grpc-energy-price-dotnet, electric-company-be

# --- HTTP version switch (REST, gRPC-Web, Graftcode WebSocket) ---
# When HTTP1 and HTTP2 URLs differ, the UI shows an HTTP version picker (shared localStorage).
#
# VITE_REST_URL_HTTP1=
# VITE_REST_URL_HTTP2=
# VITE_GRPC_URL_HTTP1=
# VITE_GRPC_URL_HTTP2=
# VITE_GRAFT_WS_URL_HTTP1=
# VITE_GRAFT_WS_URL_HTTP2=

# Legacy single URL (used when HTTP1/HTTP2 pairs are unset)
# VITE_REST_URL=
# VITE_GRPC_URL=
# VITE_GRAFT_WS_URL=

# Optional Graft transport (local h2c via Vite plugin; only with HTTP/1.1 mode)
# VITE_GRAFT_H2_PATH=/graft/h2
# VITE_GRAFT_TRANSPORT=h2
