# Copy this file to .env. Never commit the real connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://example.applicationinsights.azure.com/
AZURE_SQL_SA_PASSWORD=CityWeatherDemo123!

# Azure Service Bus (TemperatureConversionService plugin transport)
# Provide values from your namespace. Reply queue must be session-enabled.
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=your-policy;SharedAccessKey=your-key
SERVICE_BUS_QUEUE=your-request-queue
SERVICE_BUS_REPLY_QUEUE=your-request-queue.reply
SERVICE_BUS_RPC_TIMEOUT_MS=30000
