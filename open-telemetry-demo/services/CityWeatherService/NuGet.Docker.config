<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="grft" value="https://grft.dev/eb89ad77-cdc1-4369-a6aa-0393d85b6a57__free" />
    <add key="account-graft" value="https://grft.dev/4d245fd9-f4d8-476f-8fe2-fd4d7be2c763__free" />
    <add key="temperature-conversion-graft" value="https://grft.dev/61f4debe-9859-4f7b-ad12-5eed9484b636__free" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="grft">
      <package pattern="graft.nuget.*" />
      <package pattern="Hypertube.*" />
    </packageSource>
    <packageSource key="account-graft">
      <package pattern="graft.nuget.accountservice" />
    </packageSource>
    <packageSource key="temperature-conversion-graft">
      <package pattern="graft.nuget.temperatureconversionservice" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
